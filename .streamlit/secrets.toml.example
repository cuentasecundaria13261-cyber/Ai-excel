# Copy these into Streamlit Cloud: your app > Settings > Secrets.
# For local use, copy this file to .streamlit/secrets.toml (that file is ignored by git).

# Online AI for the public website (free key from console.groq.com). Never commit a real key.
GROQ_API_KEY = "paste-your-key-here"

# Optional
# GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_DAILY_CAP = 45      # AI requests per day for the whole app
# GROQ_SESSION_CAP = 4     # AI requests per visitor visit

# Feedback box (optional)
# FEEDBACK_WEBHOOK_URL = "https://..."
# FEEDBACK_ISSUES_URL = "https://github.com/YOUR_USER/YOUR_REPO/issues"
